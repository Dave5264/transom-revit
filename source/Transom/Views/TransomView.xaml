<Window
    x:Class="Transom.Views.TransomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:Transom.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:TransomViewModel}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Title="Transom"
    Height="600"
    Width="460"
    Background="#F4F3EE"
    FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Buttons: rounded; primary buttons set Background=#185FA5/Foreground=White inline -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#26251F" />
            <Setter Property="BorderBrush" Value="#CFCCC2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs: rounded -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CFCCC2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#26251F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs: minimal text with an underline on the active one -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#E3E1D9" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6B6A62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,9" Margin="0,0,22,0"
                                TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#85B7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#185FA5" />
                    <Setter Property="FontWeight" Value="Medium" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Transom;component/Resources/Icons/RibbonIcon32.png" Width="20" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="Transom" FontSize="14" FontWeight="Medium" Foreground="#26251F" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="0,1,0,0" Padding="14,12">
            <Button Content="Close" Width="84" Height="34" HorizontalAlignment="Right" Click="Close_Click" />
        </Border>

        <!-- Tabs -->
        <TabControl Margin="12" Background="Transparent" BorderThickness="0">
            <TabItem Header="Export">
                <Border Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Export schedules → spreadsheet" FontSize="14" FontWeight="Medium" Foreground="#26251F" />
                        <TextBlock DockPanel.Dock="Top" Text="Check schedules to export — each becomes a sheet (CSV writes one file per schedule)."
                                   Foreground="#6B6A62" TextWrapping="Wrap" Margin="0,6,0,12" />

                        <!-- Active schedule: pinned, always exported -->
                        <Border DockPanel.Dock="Top" Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}"
                                Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="● current view" Foreground="#185FA5" FontSize="11" VerticalAlignment="Center" />
                                <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSchedule.Name}" FontWeight="Medium" Foreground="#26251F" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Select all" Command="{Binding SelectAllSchedulesCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#185FA5" FontSize="12" Cursor="Hand" Padding="2" />
                            <TextBlock Text="All schedules" Foreground="#6B6A62" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox DockPanel.Dock="Top" Text="{Binding ScheduleFilter, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                 VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8" />

                        <!-- status pinned to the bottom (always visible) -->
                        <Border DockPanel.Dock="Bottom" Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CopyStatusCommand}"
                                        Width="26" Height="26" Margin="6,-2,-2,-2" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        VerticalAlignment="Top" ToolTip="Copy status to clipboard">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="5">
                                                <Grid Width="16" Height="16">
                                                    <Canvas x:Name="copyGlyph" Width="16" Height="16">
                                                        <Rectangle Canvas.Left="5" Canvas.Top="1" Width="9" Height="10"
                                                                   RadiusX="2" RadiusY="2" Stroke="#185FA5"
                                                                   StrokeThickness="1.3" Fill="White" />
                                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="9" Height="10"
                                                                   RadiusX="2" RadiusY="2" Stroke="#185FA5"
                                                                   StrokeThickness="1.3" Fill="White" />
                                                    </Canvas>
                                                    <Path x:Name="checkGlyph" Visibility="Collapsed"
                                                          Stroke="#0F6E56" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Data="M3,8.5 L6.5,12 L13,4.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#CFE2F4" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Copied}" Value="True">
                                                    <Setter TargetName="copyGlyph" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding Status}" Foreground="#185FA5" TextWrapping="Wrap"
                                           FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Export…" Height="34" Padding="18,0"
                                    Background="#185FA5" Foreground="White" BorderThickness="0" Command="{Binding ExportCommand}" />
                            <Button DockPanel.Dock="Right" Content="Finalize" Height="34" Padding="14,0" Margin="0,0,8,0"
                                    Background="#0F6E56" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding CanFinalize, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding FinalizeExportCommand}" />
                            <CheckBox DockPanel.Dock="Left" Content="Claude-assist" VerticalAlignment="Center" Margin="0,0,12,0"
                                      IsChecked="{Binding ClaudeAssistExport}" IsEnabled="{Binding ClaudeAvailable}"
                                      ToolTip="Stage the workbook to the exchange folder for Claude QC, then Finalize to your chosen path." />
                            <TextBlock Text="{Binding SelectionInfo}" Foreground="#9A988E" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" MinHeight="120">
                            <ListBox ItemsSource="{Binding FilteredSchedules}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Import">
                <Border Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Import spreadsheet → Revit" FontSize="14" FontWeight="Medium" Foreground="#26251F" />
                        <TextBlock DockPanel.Dock="Top" Text="Pick a Transom workbook, preview the changes, then write edits back into the model."
                                   Foreground="#6B6A62" TextWrapping="Wrap" Margin="0,6,0,12" />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#CFCCC2" BorderThickness="1" CornerRadius="4" Padding="8,0" Height="32">
                                <TextBlock Text="{Binding WorkbookPath}" Foreground="#6B6A62" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="1" Content="Browse…" Height="32" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding ChooseWorkbookCommand}" />
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Preview changes" Height="32" Padding="12,0" Command="{Binding PreviewCommand}" />
                                <Button Content="Apply selected" Height="32" Padding="16,0" Margin="8,0,0,0"
                                        Background="#185FA5" Foreground="White" BorderThickness="0" Command="{Binding ApplyCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All" Height="32" Padding="12,0" Command="{Binding SelectAllCommand}" />
                                <Button Content="None" Height="32" Padding="12,0" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox DockPanel.Dock="Top" Content="Claude-assist — write a pre-flight run-log on Preview" Margin="0,0,0,10"
                                  IsChecked="{Binding ClaudeAssistImport}" IsEnabled="{Binding ClaudeAvailable}"
                                  ToolTip="On Preview, write run-log.json to the exchange folder for Claude to review before you Apply." />

                        <Border DockPanel.Dock="Bottom" Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ImportStatus}" Foreground="#185FA5" TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <Border DockPanel.Dock="Bottom" BorderBrush="#F0D6A8" BorderThickness="1" CornerRadius="6"
                                Background="#FBF3E4" Margin="0,8,0,0" MaxHeight="84">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Skipped.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ListBox ItemsSource="{Binding Skipped}" BorderThickness="0" Background="Transparent" FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#854F0B" TextWrapping="Wrap">
                                            <Run Text="skip [" /><Run Text="{Binding Reason}" /><Run Text="] " /><Run Text="{Binding Detail}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E3E1D9"
                                  BorderThickness="1" FontSize="11.5" RowHeight="24" ColumnHeaderHeight="26"
                                  Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="30" />
                                <DataGridTextColumn Header="Element" Binding="{Binding ElementName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Old" Binding="{Binding OldValue}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Settings">
                <Border Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Claude-assist settings" FontSize="14" FontWeight="Medium" Foreground="#26251F" />
                        <TextBlock Text="The bridge is the running Revit MCP server (pyRevit Routes). The exchange folder is a Claude-readable location used for staging and run-logs."
                                   Foreground="#6B6A62" TextWrapping="Wrap" Margin="0,6,0,16" />

                        <TextBlock Text="Bridge port" Foreground="#6B6A62" FontSize="13" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshBridgeCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding BridgePort, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" />
                        </DockPanel>

                        <TextBlock Text="Claude exchange folder" Foreground="#6B6A62" FontSize="13" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseExchangeFolderCommand}" Margin="8,0,0,0" />
                            <Border BorderBrush="#CFCCC2" BorderThickness="1" CornerRadius="8" Padding="8,0" Height="32">
                                <TextBlock Text="{Binding ExchangeFolder}" Foreground="#6B6A62" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DockPanel>

                        <Border Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding BridgeStatus}" Foreground="#185FA5" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
