<Window
    x:Class="Transom.Views.TransomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:Transom.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:TransomViewModel}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Title="Transom"
    Height="880"
    Width="720"
    MinHeight="480"
    MinWidth="380"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Theme palette (light defaults; ApplyTheme() swaps these for dark to match Revit's UIThemeManager) -->
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Hint" Color="#6F6E66" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Line2" Color="#CFCCC2" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="Ok" Color="#0F6E56" />
        <SolidColorBrush x:Key="AccentHover" Color="#CFE2F4" />
        <SolidColorBrush x:Key="AltRow" Color="#F7F9FC" />
        <SolidColorBrush x:Key="WarnBg" Color="#FBF3E4" />
        <SolidColorBrush x:Key="WarnLine" Color="#F0D6A8" />
        <SolidColorBrush x:Key="Warn" Color="#854F0B" />
        <!-- Legend term colours — theme-aware so they stay legible in Revit's dark theme (ApplyTheme brightens them) -->
        <SolidColorBrush x:Key="LegendGreen" Color="#1E7A34" />
        <SolidColorBrush x:Key="LegendYellow" Color="#B8860B" />
        <SolidColorBrush x:Key="LegendRed" Color="#C0392B" />

        <!-- Buttons: rounded; primary buttons set Background=#185FA5/Foreground=White inline -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs: rounded -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs: minimal text with an underline on the active one -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,9" Margin="0,0,22,0"
                                TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="FontWeight" Value="Medium" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkboxes inherit the theme text colour (WPF's default CheckBox foreground is hard black,
             which is unreadable on the dark surface — this is the export schedule-list fix). -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- DataGrid headers + cells follow the theme (the WPF defaults are light-on-light in dark mode,
             which is why the import column headers were nearly invisible). -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Trigger>
                <!-- Frozen rows (un-writable, family/type-driven) render greyed. -->
                <DataTrigger Binding="{Binding Frozen}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Hint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource Text}">

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                          MinWidth="150" MaxWidth="220" VerticalAlignment="Center"
                          ToolTip="Project Transom is working in" />
                <Image Source="/Transom;component/Resources/Icons/RibbonIcon32.png" Width="20" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="Transom" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,12">
            <Button Content="Close" Width="84" Height="32" HorizontalAlignment="Right" Click="Close_Click" />
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="Tabs" Margin="12" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Export" IsEnabled="{Binding HasProject}">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Export schedules → spreadsheet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock DockPanel.Dock="Top" Text="Check schedules to export — each becomes a sheet (CSV writes one file per schedule)."
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <!-- Export edit-hint legend: one aligned swatch row per colour (term colours are theme-aware).
                             Copy source of truth: docs/design-notes/export-legend-copy.md (short tier here; the full
                             technical tier lives in ExportLegendDialog, opened by "More information" below). -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Cell colors show what an edit will touch on import:" Foreground="{DynamicResource Hint}" FontSize="11.5" Margin="0,0,0,4" />
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#FFFFFF" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="normal" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="instance parameter — edits the element(s) in that row, nothing else" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#DDF0DD" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="green" FontWeight="SemiBold" Foreground="{DynamicResource LegendGreen}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="type parameter (shared value) — edits every element of the type (or under the header)" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#DDEBF7" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="blue" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="project parameter in a model group — imports fine; each element keeps its own value" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#FFF2CC" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="yellow" FontWeight="SemiBold" Foreground="{DynamicResource LegendYellow}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="built-in data parameter in a model group — Transom asks how to apply it on import" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#F8D2D5" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="red" FontWeight="SemiBold" Foreground="{DynamicResource LegendRed}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="geometry-driving parameter — may only be changed through group edit mode (requires Claude-Assist to automate)" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#E6E6E6" BorderBrush="#CFCDC4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="grey" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                <TextBlock Grid.Column="2" Text="not importable — Revit computes it or locks it" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Margin="16,4,0,0" FontSize="11.5">
                                <Hyperlink Click="LegendMoreInfo_Click" Foreground="{DynamicResource Accent}" TextDecorations="None">More information…</Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- Active schedule: pinned, always exported -->
                        <Border DockPanel.Dock="Top" Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="● current view" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" />
                                <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSchedule.Name}" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Select all" Command="{Binding SelectAllSchedulesCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                                <TextBlock Text="·" Foreground="{DynamicResource Hint}" Margin="6,0" VerticalAlignment="Center" />
                                <Button Content="Select none" Command="{Binding SelectNoneSchedulesCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                            </StackPanel>
                            <TextBlock Text="All schedules" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="FilterBox" Text="{Binding ScheduleFilter, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     ToolTip="Type to filter the schedule list by name" />
                            <!-- placeholder: shown only while the box is empty -->
                            <TextBlock Text="Filter schedules…" Foreground="{DynamicResource Hint}" FontSize="12"
                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- status pinned to the bottom (always visible) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CopyStatusCommand}"
                                        Width="26" Height="26" Margin="6,-2,-2,-2" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        VerticalAlignment="Top" ToolTip="Copy status to clipboard">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="5">
                                                <Grid Width="16" Height="16">
                                                    <Canvas x:Name="copyGlyph" Width="16" Height="16">
                                                        <Rectangle Canvas.Left="5" Canvas.Top="1" Width="9" Height="10"
                                                                   RadiusX="2" RadiusY="2" Stroke="{DynamicResource Accent}"
                                                                   StrokeThickness="1.3" Fill="{DynamicResource Surface}" />
                                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="9" Height="10"
                                                                   RadiusX="2" RadiusY="2" Stroke="{DynamicResource Accent}"
                                                                   StrokeThickness="1.3" Fill="{DynamicResource Surface}" />
                                                    </Canvas>
                                                    <Path x:Name="checkGlyph" Visibility="Collapsed"
                                                          Stroke="{DynamicResource Ok}" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Data="M3,8.5 L6.5,12 L13,4.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Copied}" Value="True">
                                                    <Setter TargetName="copyGlyph" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"
                                           FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Export…" Height="32" Padding="18,0"
                                    Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Command="{Binding ExportCommand}"
                                    ToolTip="Save the ticked schedules to a spreadsheet" />
                            <TextBlock Text="{Binding SelectionInfo}" Foreground="{DynamicResource Hint}" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" MinHeight="120">
                            <ListBox ItemsSource="{Binding FilteredSchedules}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Import" IsEnabled="{Binding HasProject}">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Import spreadsheet → Revit" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock DockPanel.Dock="Top" Text="Pick a Transom workbook, preview the changes, then write edits back into the model."
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="8,0" Height="32">
                                <TextBlock Text="{Binding WorkbookPath}" Foreground="{DynamicResource Muted}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="1" Content="Browse…" Height="32" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding ChooseWorkbookCommand}" />
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Preview changes" Height="32" Padding="12,0" Command="{Binding PreviewCommand}"
                                        ToolTip="Compare the workbook to the live model (read-only) and list what would change" />
                                <!-- Apply hidden during step 1 (select tabs): you resolve+preview before applying (Change 1, §8.3) -->
                                <Button Content="Apply selected" Height="32" Padding="16,0" Margin="8,0,0,0"
                                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Command="{Binding ApplyCommand}"
                                        Visibility="{Binding InPreviewStep, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanApply}"
                                        ToolTip="Preview changes first, then this writes the ticked changes into the model (greyed while rows at the top of the list still need Confirm or Discard)" />
                            </StackPanel>
                            <!-- Cell-level All/None act on the changes grid → hidden during step 1 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding InPreviewStep, Converter={StaticResource BoolToVis}}">
                                <Button Content="All" Height="32" Padding="12,0" Command="{Binding SelectAllCommand}" />
                                <Button Content="None" Height="32" Padding="12,0" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox DockPanel.Dock="Top" Content="Create colour-coded error report (.xlsx) on Preview"
                                  IsChecked="{Binding ProduceReport}" Foreground="{DynamicResource Muted}"
                                  FontSize="12" Margin="0,0,0,10"
                                  ToolTip="Writes &lt;workbook&gt;_import-report.xlsx — blue = skipped, yellow = changed since export, red = unable to write" />

                        <!-- §16 PRE-ANALYSIS TAB PICKER: choose which schedules to analyze BEFORE the (slow) diff runs.
                             Shown only in the pick phase; analyzing only the ticked tabs avoids the ~2-min full-workbook scan. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="9,7" CornerRadius="6"
                                Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                                Visibility="{Binding InTabPickStep, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Select all" Command="{Binding SelectAllTabsCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                                        <TextBlock Text="·" Foreground="{DynamicResource Hint}" Margin="6,0" VerticalAlignment="Center" />
                                        <Button Content="Select none" Command="{Binding SelectNoneTabsCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                                    </StackPanel>
                                    <TextBlock Text="Choose schedules to analyze:" FontWeight="SemiBold"
                                               FontSize="11.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Hint}"
                                           Text="Only the ticked schedules are analyzed and can be imported — skip the rest to avoid a long full-workbook scan." />
                                <Button DockPanel.Dock="Bottom" Content="Analyze selected" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Padding="16,6" Height="32" Cursor="Hand"
                                        Command="{Binding AnalyzeSelectedCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" />
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PickableTabs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsThreeState="False" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Content="{Binding ScheduleName}" FontSize="11.5" Margin="0,1"
                                                          Foreground="{DynamicResource Text}" VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>


                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CopyImportStatusCommand}"
                                        Width="26" Height="26" Margin="6,-2,-2,-2" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        VerticalAlignment="Top" ToolTip="Copy status to clipboard">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="5">
                                                <Grid Width="16" Height="16">
                                                    <Canvas x:Name="copyGlyph" Width="16" Height="16">
                                                        <Rectangle Canvas.Left="5" Canvas.Top="1" Width="9" Height="10" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Fill="{DynamicResource Surface}" />
                                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="9" Height="10" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Fill="{DynamicResource Surface}" />
                                                    </Canvas>
                                                    <Path x:Name="checkGlyph" Visibility="Collapsed" Stroke="{DynamicResource Ok}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,8.5 L6.5,12 L13,4.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CopiedImport}" Value="True">
                                                    <Setter TargetName="copyGlyph" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button DockPanel.Dock="Right" Command="{Binding CopyDiagnosticLogCommand}" Margin="8,0,0,0"
                                        ToolTip="Copy the full import diagnostic log to the clipboard">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Copy log" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CopiedLog}" Value="True">
                                                    <Setter Property="Content" Value="Copied!" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="Open report" Command="{Binding OpenReportCommand}" Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReportPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding ImportStatus}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"
                                           FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Detailed skip-log: belongs to the PREVIEW step (step 2); hidden during step-1 selection (FIX B) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource WarnBg}" Margin="0,8,0,0" MaxHeight="84">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Skipped.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding InSelectStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <!-- §3b surface-4: section header with a subtle "(selected schedules only)" hint in subset mode -->
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,3" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Warn}">
                                    <Run Text="Skipped" /><Run Text=" (selected schedules only)" FontWeight="Normal"
                                         Foreground="{DynamicResource Hint}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Text" Value=" (selected schedules only)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SkipLogScopedToSelection}" Value="False">
                                                        <Setter Property="Text" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Skipped}" BorderThickness="0" Background="Transparent" FontSize="11">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{DynamicResource Warn}" TextWrapping="Wrap">
                                                <Run Text="skip [" /><Run Text="{Binding Reason}" /><Run Text="] " /><Run Text="{Binding Detail}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Fix-unparseable pane: enter valid values, then Preview again to re-validate + write back -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource WarnBg}" Margin="0,8,0,0" MaxHeight="156">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Fixes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- FIX B: the fix pane belongs to the PREVIEW step (step 2) — hide it during step-1 selection. -->
                                        <DataTrigger Binding="{Binding InSelectStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel Margin="10,8">
                                <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Warn}" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Fix unparseable values — enter a valid value (matching the schedule's units), then click Preview changes again." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Fixes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="136" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                                                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                            <Run Text="{Binding FieldName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ElementLabel, Mode=OneWay}" /><Run Text="   was “" /><Run Text="{Binding BadValue, Mode=OneWay}" /><Run Text="”" />
                                                        </TextBlock>
                                                        <TextBox Grid.Column="1" Height="26" FontSize="11.5"
                                                                 Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                    <!-- Reformat-confirm row: shown when the entry parses but isn't in the schedule's format -->
                                                    <DockPanel Margin="0,4,0,0"
                                                               Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">
                                                        <Button DockPanel.Dock="Right" Content="Confirm" Height="24" Padding="12,0"
                                                                Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" FontSize="11"
                                                                Command="{Binding DataContext.ConfirmFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="you typed “" /><Run Text="{Binding BadValue, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="” — interpreted as “" /><Run Text="{Binding Suggested, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="” — confirm to use the schedule's format" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Frozen-cells note: shown when any preview row is un-writable (family/type-driven) -->
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Visibility="{Binding HasFrozen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap">
                                <Run Text="⊘ " Foreground="{DynamicResource Hint}" /><Run Text="Greyed rows can't be changed by import — those values are driven by the element's family or type. Set them by picking an option on the element or editing the family/type, not in the spreadsheet." />
                            </TextBlock>
                        </Border>

                        <!-- Which schedules this import will change (shown on Preview) — per-schedule selection -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="9,7" CornerRadius="6"
                                Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                                Visibility="{Binding HasAffected, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <!-- Header: title + right-aligned Select all/none (only when >1 schedule) -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                Visibility="{Binding HasMultipleAffected, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Select all" Command="{Binding SelectAllAffectedCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                                        <TextBlock Text="·" Foreground="{DynamicResource Hint}" Margin="6,0" VerticalAlignment="Center" />
                                        <Button Content="Select none" Command="{Binding SelectNoneAffectedCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" FontSize="12" Cursor="Hand" Padding="2" />
                                    </StackPanel>
                                    <TextBlock Text="Schedules this import will change:" FontWeight="SemiBold"
                                               FontSize="11.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- Helper line: shown only when at least one schedule is fully deselected -->
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Hint}" Text="{Binding AffectedSelectionInfo}"
                                           Visibility="{Binding SomeAffectedDeselected, Converter={StaticResource BoolToVis}}" />
                                <!-- Per-schedule rows: a checkbox driving the schedule's changes' Selected, with read-only
                                     dependent ("inherited-change") schedules indented underneath (Change 2).
                                     Change 1: wrap in a ScrollViewer (MaxHeight + Auto vbar) so a long affected-schedules
                                     list scrolls instead of pushing the window past the screen — mirrors the export ListBox /
                                     fix-pane scroll behaviour. -->
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AffectedSchedules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <DockPanel>
                                                    <!-- Disclosure toggle for the dependent subtree (only when there are dependents);
                                                         glyph swaps ▸/▾ via a trigger on IsChecked (no converter needed) -->
                                                    <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Visibility="{Binding HasDependents, Converter={StaticResource BoolToVis}}"
                                                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                  Foreground="{DynamicResource Hint}" Width="14" Padding="0"
                                                                  VerticalAlignment="Center">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Content" Value="▸" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="Content" Value="▾" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <!-- Change 2: IsThreeState="False" so a direct user CLICK cycles only
                                                         checked↔unchecked (never produces the indeterminate null the setter
                                                         ignores — which was why a click couldn't uncheck a schedule). The
                                                         indeterminate visual still shows when the bound bool? is null (mixed
                                                         per-cell selection) — IsThreeState only governs click-produced values. -->
                                                    <CheckBox IsThreeState="False" IsChecked="{Binding SelectionState, Mode=TwoWay}"
                                                              Content="{Binding Display}" FontSize="11.5"
                                                              Foreground="{DynamicResource Text}" VerticalContentAlignment="Center" />
                                                </DockPanel>
                                                <!-- Dependents: read-only, indented, greyed; visible only when this parent is selected + expanded (§9.5 deselect cascade) -->
                                                <ItemsControl ItemsSource="{Binding Dependents}" Margin="22,0,0,0"
                                                              Visibility="{Binding ShowDependents, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource Hint}" Margin="0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <!-- Step 1 → step 2: resolve conflicts on selected tabs, then show the changes preview.
                                     FIX A: size-to-content (no fixed/Max Width) + roomy padding so the full label isn't clipped. -->
                                <Button DockPanel.Dock="Bottom" Content="Resolve &amp; preview selected" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Padding="16,6" Height="32" Cursor="Hand"
                                        Command="{Binding ResolveAndPreviewCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                                        Visibility="{Binding InSelectStep, Converter={StaticResource BoolToVis}}" />
                            </DockPanel>
                        </Border>

                        <!-- Changes grid hidden during step 1 (select tabs); shown after Resolve & preview (Change 1, §8.3).
                             RowDetails carries the inline "interpreted as … — confirm" strip for format-mismatched
                             (NeedsConfirm) rows — rendered BELOW the row (full width, doesn't stretch the row sideways)
                             so the confirmation sits next to the change it's about, not in a separate bottom pane. -->
                        <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Visibility="{Binding InPreviewStep, Converter={StaticResource BoolToVis}}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource Line}"
                                  BorderThickness="1" FontSize="11.5" RowHeight="24" ColumnHeaderHeight="26"
                                  Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}"
                                  AlternatingRowBackground="{DynamicResource AltRow}" Foreground="{DynamicResource Text}"
                                  RowDetailsVisibilityMode="Visible">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" MinWidth="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEnabled="{Binding Selectable}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Element" Binding="{Binding ElementName}" Width="Auto" MinWidth="90" MaxWidth="260" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding ElementName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="Auto" MinWidth="50" IsReadOnly="True" />
                                <DataGridTextColumn Header="Old" Binding="{Binding OldValue}" Width="Auto" MinWidth="50" IsReadOnly="True" />
                                <!-- New: a pending (NeedsConfirm) row shows its interpreted value italic + warn-coloured until confirmed -->
                                <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="Auto" MinWidth="50" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsConfirm}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto" IsReadOnly="True" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <!-- Inline confirm strip — shown only for pending rows; collapsed for normal changes.
                                         Same functionality as the old bottom fix-pane (editable value box + Confirm),
                                         now in line with the row. Edit the box to CORRECT the interpretation (e.g. "7""
                                         if you meant inches), then Confirm — the interpreted value lands in New. -->
                                    <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="0,0,0,1"
                                            Padding="10,5" Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <!-- Discard: drop this edit — the row disappears, nothing is written, and it's logged as
                                                 "discarded by user". Every pending row must be Confirmed or Discarded before Apply.
                                                 Declared FIRST with Dock=Right so it sits RIGHTMOST — Confirm (declared next) lands to
                                                 its left, i.e. visual order: [value box] [Confirm] [Discard]. -->
                                            <Button DockPanel.Dock="Right" Content="Discard" Height="26" Padding="10,0" Margin="8,0,0,0"
                                                    Background="Transparent" BorderBrush="{DynamicResource LegendRed}" BorderThickness="1"
                                                    Foreground="{DynamicResource LegendRed}" FontSize="11" Cursor="Hand"
                                                    AutomationProperties.Name="DiscardValue" AutomationProperties.AutomationId="DiscardValue"
                                                    ToolTip="Drop this edit — the row disappears and nothing is written for it"
                                                    PreviewMouseLeftButtonDown="DiscardButton_PreviewMouseLeftButtonDown"
                                                    Command="{Binding DataContext.DiscardRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Confirm" Height="26" Padding="14,0" Margin="8,0,0,0"
                                                    Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" FontSize="11"
                                                    AutomationProperties.Name="ConfirmValue" AutomationProperties.AutomationId="ConfirmValue"
                                                    PreviewMouseLeftButtonDown="ConfirmButton_PreviewMouseLeftButtonDown"
                                                    Command="{Binding DataContext.ConfirmRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox DockPanel.Dock="Right" Width="110" Height="26" FontSize="11.5" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="ConfirmValueBox" AutomationProperties.AutomationId="ConfirmValueBox"
                                                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewMouseLeftButtonDown="EditBox_PreviewMouseLeftButtonDown"
                                                     GotKeyboardFocus="EditBox_GotKeyboardFocus"
                                                     ToolTip="Edit if Transom read the units wrong (e.g. type 7&quot; for 7 inches), then Confirm" />
                                            <!-- The interpretation shown for confirmation — updates ONLY on Confirm (never as you type).
                                                 Replaced by the "enter a usable value" note when the last confirm couldn't parse. -->
                                            <Grid>
                                                <!-- (a) readable value: shows the interpretation to confirm. Hidden if there's an
                                                     error OR no interpretation yet (an unreadable entry not yet fixed). -->
                                                <TextBlock Foreground="{DynamicResource Warn}" FontSize="11" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasConfirmError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Suggestion}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding ElementName, Mode=OneWay}" /><Run Text=": you typed “" /><Run Text="{Binding EnteredValue, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="” — interpreted as “" /><Run Text="{Binding Suggestion, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="” · confirm to apply, or discard" />
                                                </TextBlock>
                                                <!-- (b) no interpretation yet and no error (e.g. an unreadable entry the user is
                                                     editing): neutral prompt. -->
                                                <TextBlock Foreground="{DynamicResource Warn}" FontSize="11" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           Text="enter a value, then confirm">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasConfirmError}" Value="False" />
                                                                        <Condition Binding="{Binding Suggestion}" Value="" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- (c) the last confirm couldn't read the value: red "enter a usable value". -->
                                                <TextBlock Foreground="{DynamicResource LegendRed}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ConfirmError}"
                                                           Visibility="{Binding HasConfirmError, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <!-- CLAUDE SKILLS (user request 2026-07-18): a library of reusable Claude workflow .md files.
                 Greyed out while Claude Assist is off — the skills only make sense with a connected session. -->
            <TabItem Header="Claude Skills" IsEnabled="{Binding IsClaudeAssistEnabled}"
                     ToolTip="Reusable Claude workflow skills — turn Claude Assist on in Settings to enable">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Claude Skills" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock DockPanel.Dock="Top"
                                   Text="A repository for Claude skills — reusable workflow files (.md) that can be saved and staged to repeat automated workflows with Claude Code. Skills that ship with Transom, that Claude saves, or that you import all live in the library folder below."
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />

                        <!-- Bottom stack (dock order = outermost first): demo button, bridge status, bypass warning, description. -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Left" Content="Show me what you can do" Height="28" Padding="12,0" FontSize="12"
                                    VerticalAlignment="Center" Click="Showcase_Click"
                                    ToolTip="Export a guided demo — Claude builds a small shed in a fresh project while you watch" />
                            <TextBlock Text="Not sure what to ask Claude for? Export a demo script it can run in a fresh project so you can watch it work."
                                       Foreground="{DynamicResource Hint}" FontSize="11.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>

                        <!-- Bridge status — the same live checklist as the Settings tab (same bindings). -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel Background="{DynamicResource InfoBg}">
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshClaudeStatusCommand}"
                                            FontSize="11" Height="22" Padding="8,0" Margin="0,3,4,3"
                                            ToolTip="Re-check the bridge, shim, and Claude registration" />
                                    <TextBlock Text="Status" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ClaudeStatusRows}" Margin="0,2,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="10,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource Hint}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock FontWeight="Bold" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✗" />
                                                            <Setter Property="Foreground" Value="{DynamicResource LegendRed}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource LegendGreen}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Same bypass-permissions advisory as Settings (the tab is only enabled with Assist on). -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Why?" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"
                                    FontSize="11.5" Cursor="Hand" Padding="4,0" Click="BypassWhy_Click"
                                    ToolTip="Why Claude Code needs bypass permissions for UI-assist" />
                            <TextBlock Foreground="{DynamicResource Warn}" FontSize="11.5" TextWrapping="Wrap"
                                       Text="⚠ Run Claude Code with bypass permissions enabled — otherwise its permission prompts steal focus from Revit and UI-assist clicks silently miss." />
                        </DockPanel>

                        <!-- Highlighted skill's description (frontmatter description:) + the last action's result. -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="{Binding SkillStatus}" Foreground="{DynamicResource Accent}" FontSize="11.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkillStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Description" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,6,0,4" />
                            <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="8,6" MinHeight="44">
                                <TextBlock Text="{Binding SelectedSkillDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- The library: list of skills (fills) + the action buttons beside it. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SkillsFolder}" Foreground="{DynamicResource Hint}"
                                           FontSize="10.5" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="The skill library folder — Claude saves new skills here; Import copies files in" />
                                <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}"
                                         Background="Transparent" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FileName}" Foreground="{DynamicResource Hint}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="12.5"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Button Content="Stage" Width="96" Height="30" Command="{Binding StageSkillCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                                        ToolTip="Copy the skill's file path to the clipboard — paste it into your Claude Code session to run it" />
                                <Button Content="Import…" Width="96" Height="30" Margin="0,8,0,0" Command="{Binding ImportSkillCommand}"
                                        ToolTip="Copy a skill .md file from anywhere into the library" />
                                <Button Content="Remove" Width="96" Height="30" Margin="0,8,0,0" Command="{Binding RemoveSkillCommand}"
                                        ToolTip="Delete the selected skill file from the library" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Settings">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="How Claude Code works" Height="28" Padding="12,0"
                                    FontSize="12" VerticalAlignment="Top" Click="ClaudeHelp_Click" />
                            <TextBlock Text="Claude Assist" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Let a connected Claude Code session review exports against the live model, apply staged edits, and run Revit operations you ask for. Everything stays on this machine (loopback only, per-user, no admin)."
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14" />

                        <!-- The one Claude switch (replaces the old Off/Verify/Assist dropdown + the Set up Claude /
                             Claude Bridge ribbon buttons). First ON runs one-time setup, then starts the bridge. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox IsChecked="{Binding IsClaudeAssistEnabled}" IsEnabled="{Binding ClaudeToggleEnabled}"
                                      VerticalAlignment="Center" Cursor="Hand">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                    Background="{DynamicResource Line2}" VerticalAlignment="Center">
                                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource Surface}"
                                                         Stroke="{DynamicResource Line2}" StrokeThickness="1"
                                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                                            </Border>
                                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Off" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClaudeAssistEnabled}" Value="True">
                                                    <Setter Property="Text" Value="On" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Text="{Binding ClaudeAssistHint}" Foreground="{DynamicResource Hint}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <!-- Bypass-permissions advisory (shown only while Claude Assist is ON): permission prompts in
                             the Claude client steal Windows focus from Revit mid-sequence, so UI-assist clicks/keys
                             miss without Claude knowing. The Why? link explains the failure mode in depth. -->
                        <DockPanel Margin="0,4,0,0"
                                   Visibility="{Binding IsClaudeAssistEnabled, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Content="Why?" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"
                                    FontSize="11.5" Cursor="Hand" Padding="4,0" Click="BypassWhy_Click"
                                    ToolTip="Why Claude Code needs bypass permissions for UI-assist" />
                            <TextBlock Foreground="{DynamicResource Warn}" FontSize="11.5" TextWrapping="Wrap"
                                       Text="⚠ Run Claude Code with bypass permissions enabled — otherwise its permission prompts steal focus from Revit and UI-assist clicks silently miss." />
                        </DockPanel>

                        <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding HasRestartNotice, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding RestartNotice}" Foreground="{DynamicResource Warn}" FontSize="11.5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Always-visible status checklist (replaces the Bridge Status ribbon dialog). -->
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel Background="{DynamicResource InfoBg}">
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshClaudeStatusCommand}"
                                            FontSize="11" Height="22" Padding="8,0" Margin="0,3,4,3"
                                            ToolTip="Re-check the bridge, shim, and Claude registration" />
                                    <TextBlock Text="Status" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="Not set up — turn Claude Assist on to set it up. Registers Transom's tools with Claude Code."
                                           Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="10,8,10,8"
                                           Visibility="{Binding ClaudeNotSetUp, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ClaudeStatusRows}" Margin="0,2,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="10,3">
                                                <!-- "?" on the Claude-running row when red: that detection can false-negative
                                                     (Claude Code in a terminal/VS Code/node) — the dialog says how to connect anyway. -->
                                                <Button DockPanel.Dock="Right" Content="?" Click="ClaudeRunningHelp_Click"
                                                        Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVis}}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"
                                                        FontSize="11.5" FontWeight="Bold" Cursor="Hand" Padding="4,0" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="This check can miss a running Claude Code session — click for how to connect anyway" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource Hint}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock FontWeight="Bold" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✗" />
                                                            <Setter Property="Foreground" Value="{DynamicResource LegendRed}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource LegendGreen}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ClaudeStatusFooter}" Foreground="{DynamicResource Hint}" FontSize="11" Margin="10,2,10,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClaudeStatusFooter}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Claude exchange folder" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,14,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseExchangeFolderCommand}" Margin="8,0,0,0" />
                            <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="8" Padding="8,0" Height="32">
                                <TextBlock Text="{Binding ExchangeFolder}" Foreground="{DynamicResource Muted}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DockPanel>
                        <!-- (Claude instructions are written automatically next to the staged group-edits JSON when Claude-Assist runs.
                             The button below exports the same operating instructions standalone, for driving Revit with NO staged edit.) -->

                        <DockPanel Margin="0,10,0,4">
                            <Button DockPanel.Dock="Left" Content="Claude Assist" Height="28" Padding="12,0" FontSize="12"
                                    VerticalAlignment="Center" Command="{Binding ExportClaudeAssistGuideCommand}"
                                    ToolTip="Export the Claude Assist guide (.md) — connect Claude Code to Revit without a staged edit" />
                            <TextBlock Text="Export this .md file and drop it into your Claude Code session to connect Claude with Revit — no staged edit needed."
                                       Foreground="{DynamicResource Hint}" FontSize="11.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>

                        <!-- First-taste demo for users who can't think of an opening ask: the dialog explains,
                             and exports a .md that has Claude build a small shed on command in a fresh project. -->
                        <DockPanel Margin="0,2,0,4">
                            <Button DockPanel.Dock="Left" Content="Show me what you can do" Height="28" Padding="12,0" FontSize="12"
                                    VerticalAlignment="Center" Click="Showcase_Click"
                                    ToolTip="Export a guided demo — Claude builds a small shed in a fresh project while you watch" />
                            <TextBlock Text="Not sure what to ask Claude for? Export a demo script it can run in a fresh project so you can watch it work."
                                       Foreground="{DynamicResource Hint}" FontSize="11.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>

                        <Expander Margin="0,6,0,0">
                            <Expander.Header>
                                <TextBlock Text="Advanced" Foreground="{DynamicResource Accent}" FontSize="12" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Bridge port" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,4" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Changing the port re-registers Claude Code and restarts the bridge."
                                               Foreground="{DynamicResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding BridgePort, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" />
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Separator Margin="0,18,0,12" Background="{DynamicResource Line}" />
                        <TextBlock Text="Preferences" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,8" />
                        <CheckBox Content="Show me encouraging messages now and then 🎉"
                                  IsChecked="{Binding EncouragingMessages}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                        <TextBlock Text="A little pick-me-up that occasionally appears after you export or import."
                                   Foreground="{DynamicResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
