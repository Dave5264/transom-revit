<Window
    x:Class="Transom.Views.TransomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:Transom.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:TransomViewModel}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Title="Transom"
    Height="600"
    Width="460"
    Background="#F4F3EE"
    FontFamily="Segoe UI">
    <DockPanel>

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Transom;component/Resources/Icons/RibbonIcon32.png" Width="20" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="Transom" FontSize="14" FontWeight="Medium" Foreground="#26251F" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="0,1,0,0" Padding="14,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Export" Width="150" Height="34" Background="#185FA5" Foreground="White"
                        BorderThickness="0" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="12" Background="Transparent" BorderThickness="0">
            <TabItem Header="Export">
                <Border Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Export schedule → spreadsheet" FontSize="14" FontWeight="Medium" Foreground="#26251F" />
                        <TextBlock Text="Choose a schedule and export it to .xlsx with full visual fidelity and a hidden round-trip anchor."
                                   Foreground="#6B6A62" TextWrapping="Wrap" Margin="0,6,0,14" />

                        <TextBlock Text="Schedule" Foreground="#6B6A62" FontSize="13" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Schedules}"
                                  SelectedItem="{Binding SelectedSchedule}"
                                  DisplayMemberPath="Name"
                                  Height="32" />

                        <Border Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Status}" Foreground="#185FA5" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Import">
                <Border Background="#FFFFFF" BorderBrush="#E3E1D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Import spreadsheet → Revit" FontSize="14" FontWeight="Medium" Foreground="#26251F" />
                        <TextBlock Text="Pick a previously exported workbook, preview the changes, and write edits back into the model."
                                   Foreground="#6B6A62" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Background="#E6F1FB" BorderBrush="#85B7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="Built in the next milestone — auto-match, diff preview, conflict handling."
                                       Foreground="#185FA5" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
