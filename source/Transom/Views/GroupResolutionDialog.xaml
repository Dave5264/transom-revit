<Window
    x:Class="Transom.Views.GroupResolutionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Resolve group conflict"
    SizeToContent="Height"
    Width="560"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="Pros" Color="#2E7D32" />
        <SolidColorBrush x:Key="Cons" Color="#B26A00" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">
        <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" />

        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel x:Name="OptionsPanel" />
        </Border>

        <TextBlock x:Name="UnavailableNote" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel import" Height="32" Padding="12,0" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Apply choice" Height="32" Padding="18,0" Background="{DynamicResource Accent}" Foreground="White"
                    BorderThickness="0" Click="Apply_Click" />
        </StackPanel>
    </StackPanel>
</Window>
