<Window
    x:Class="Transom.Views.ShowcaseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Show me what you can do"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
    </Window.Resources>
    <StackPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <TextBlock Text="Create a new project in Revit and drop this .md file into Claude Code"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                   Text="Hard to know what to ask for first? Export the demo file, start a fresh throwaway project (File ▸ New), and drop the .md into a Claude Code session. Claude will connect to Revit — helping you get set up if anything's missing — and then wait for your go." />

        <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12"
                       Text="On your word, Claude builds a small shed in front of you: four walls, a pitched roof with proper overhangs, a door and a window — then reveals it in its own section-boxed 3D view. A nice first taste of what you can ask for." />
        </Border>

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,8,0,0"
                   Text="Just turned Claude Assist on for the first time? Restart Claude Code before dropping the file — it loads new MCP servers only at startup." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Export demo file" Command="{Binding ExportShowcaseGuideCommand}"
                    Height="30" Padding="12,0" />
            <Button Content="Close" Click="Close_Click" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
