<Window
    x:Class="Transom.Views.HelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transom — Help &amp; Support"
    Width="620"
    Height="720"
    ResizeMode="CanResizeWithGrip"
    MinWidth="480"
    MinHeight="420"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Hint" Color="#9A988E" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
        <SolidColorBrush x:Key="WarnBg" Color="#FBF3DE" />
        <SolidColorBrush x:Key="WarnLine" Color="#E4C474" />
        <SolidColorBrush x:Key="Warn" Color="#8A6D1F" />

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,16,0,5" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Foreground="{DynamicResource Hint}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Report an issue" Height="30" Padding="12,0" Margin="0,0,8,0" Click="Issues_Click" />
                <Button Content="Releases / docs" Height="30" Padding="12,0" Margin="0,0,8,0" Click="Releases_Click" />
                <Button Content="Close" Height="30" Padding="14,0" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Transom — Help" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12.5"
                   Text="Transom round-trips Revit schedules through a spreadsheet: export a schedule exactly as Revit shows it, edit the values in Excel, then import your changes back into the model — safely, inside a single transaction, with a preview you confirm first." />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- QUICK START -->
                <TextBlock Style="{StaticResource H}" Margin="0,2,0,5" Text="Quick start" />
                <TextBlock Style="{StaticResource P}">
                    <Run Text="1." FontWeight="SemiBold" /> On the <Run Text="Export" FontWeight="SemiBold" /> tab, tick one or more schedules and save an <Run Text=".xlsx" FontWeight="SemiBold" />.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="2." FontWeight="SemiBold" /> Edit values in Excel. Leave the hidden column and the hidden sheet alone (see “Editing rules”).
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="3." FontWeight="SemiBold" /> On the <Run Text="Import" FontWeight="SemiBold" /> tab, Browse to the file → <Run Text="Preview changes" FontWeight="SemiBold" /> → review → <Run Text="Apply selected" FontWeight="SemiBold" />.
                </TextBlock>

                <!-- EXPORT -->
                <TextBlock Style="{StaticResource H}" Text="Exporting" />
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Pick schedules" FontWeight="SemiBold" /> — the active schedule is pinned at the top; use the filter box, Select all / none, and the counter to choose from the rest. Switch projects with the project dropdown.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Full visual fidelity" FontWeight="SemiBold" /> — fonts, colours, alignment, borders, merged headers, grouping, subtotals/grand totals, hidden columns and fitted widths are reproduced. Calculated, combined, percentage and count fields export exactly as Revit displays them.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Formats" FontWeight="SemiBold" /> — <Run Text=".xlsx" FontWeight="SemiBold" /> (recommended, full round-trip), legacy <Run Text=".xls" FontWeight="SemiBold" />, or <Run Text=".csv" FontWeight="SemiBold" /> (display-only, not round-trippable; one file per schedule).
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Multiple schedules" FontWeight="SemiBold" /> → one worksheet each in a single workbook. A schedule placed on several sheets appears once in the list (its internal sheet copies are hidden).
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Combined-parameter fields" FontWeight="SemiBold" /> (e.g. “Width x Height”) stay display-only on the main sheet but get a companion “… — parts” sheet exposing each underlying component as its own editable column.
                </TextBlock>
                <TextBlock Style="{StaticResource P}" Margin="0,0,0,2">
                    • <Run Text="Edit-hint colours" FontWeight="SemiBold" /> in the exported file:
                </TextBlock>
                <TextBlock Style="{StaticResource P}" Margin="14,0,0,4">
                    – <Run Text="Grey" FontWeight="SemiBold" /> cells can’t be imported (read-only, or driven by the family/type, or calculated).
                    &#x0a;– <Run Text="Green" FontWeight="SemiBold" Foreground="#1E7A34" /> cells are bulk edits — a type parameter or a group header, where changing one cell updates every element it covers (no Claude needed).
                    &#x0a;– <Run Text="Blue" FontWeight="SemiBold" /> cells are instance parameters on elements inside a Revit model group — importable only via Claude-assist.
                    &#x0a;– Other cells edit a single element.
                </TextBlock>

                <!-- EDITING RULES -->
                <TextBlock Style="{StaticResource H}" Text="Editing rules (important)" />
                <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warn}" FontSize="12.5" Margin="0,0,0,3">
                            • <Run Text="Keep the hidden anchor column and the hidden “cowork_meta” sheet." FontWeight="SemiBold" /> They link each row to its element. Delete either and the file can’t be imported.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warn}" FontSize="12.5" Margin="0,0,0,3">
                            • <Run Text="Don’t merge cells, duplicate rows, or rename the worksheet tab." FontWeight="SemiBold" /> Merged cells and duplicated rows are skipped (and reported) for safety; a renamed tab won’t be matched.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warn}" FontSize="12.5">
                            • Editing the value cells is what matters. You can sort/reorder rows freely — the anchor follows the element, not the row position.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource P}" Margin="0,4,0,4">
                    Match the schedule’s units when typing numbers (e.g. <Run Text="3' - 6&quot;" FontStyle="Italic" />). If a value parses but isn’t in the schedule’s format, import offers to convert it; if it can’t be read, import asks you to fix it. Schedules with column headers turned off, or with banded/multi-row headers, still round-trip.
                </TextBlock>

                <!-- ROUND-TRIP SUPPORT -->
                <TextBlock Style="{StaticResource H}" Text="Which schedules round-trip" />
                <TextBlock Style="{StaticResource P}">
                    <Run Text="Round-trips:" FontWeight="SemiBold" /> itemized schedules; schedules grouped by type (windows, doors, walls); schedules grouped by a field (rooms, areas) when the group fields are visible columns; key schedules; and annotation / keyed-note (Note Block) schedules.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="Display-only" FontStyle="Italic" /> (export only, no write-back): material takeoffs, embedded schedules, linked-model elements, keynote legends whose text lives in the keynote file, hierarchical grouping with hidden group fields, and empty schedules. Transom flags these and skips write-back with a clear reason.
                </TextBlock>

                <!-- IMPORT PREVIEW -->
                <TextBlock Style="{StaticResource H}" Text="The import preview" />
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Schedules this import will change" FontWeight="SemiBold" /> — a summary list at the top of the changes, with a per-schedule count (handy for multi-schedule workbooks).
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Changes grid" FontWeight="SemiBold" /> — element · field · old → new · scope. Tick/untick any row; use Select all / none. Scope shows “instance”, “type · N inst”, or “⚠ group”.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Greyed (frozen) rows" FontWeight="SemiBold" /> can’t be changed by import — they’re read-only or driven by the family/type. They’re shown for context, never applied.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Fix-unparseable pane" FontWeight="SemiBold" /> — values that can’t be read, or aren’t in the schedule’s unit format, are held with an input box; correct or confirm, then Preview again.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Type-parameter conflicts" FontWeight="SemiBold" /> — if rows sharing one type disagree on a new value, import asks you to pick (or skips); a consistent edit writes once to the type.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Group dialog" FontWeight="SemiBold" /> — edits on elements inside Revit groups can be skipped, cancelled, or (in Assist mode) handed to Claude.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Copy log" FontWeight="SemiBold" /> — copies a full diagnostic (column matching, anchors, every skip/conflict) to the clipboard for troubleshooting.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Error report" FontWeight="SemiBold" /> (optional checkbox) — writes a colour-coded .xlsx: blue = skipped, yellow = changed since export, red = unable to write.
                </TextBlock>

                <!-- SAFETY -->
                <TextBlock Style="{StaticResource H}" Text="How write-back stays safe" />
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Three-way compare" FontWeight="SemiBold" /> — only cells you actually changed are written. If the model changed since export, that’s flagged as “drift”, never silently reverted.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Verified writes" FontWeight="SemiBold" /> — every parameter is re-read after setting to confirm it took; failures are reported, not assumed.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="One transaction" FontWeight="SemiBold" /> — all changes apply together and roll back on a fatal error. Non-Transom workbooks, or files with a missing anchor, are rejected rather than mis-written.
                </TextBlock>

                <!-- CLAUDE / MCP -->
                <TextBlock Style="{StaticResource H}" Text="Claude QA (optional)" />
                <TextBlock Style="{StaticResource P}">
                    Transom works fully on its own. With Claude connected over a local MCP bridge you get two extra modes (Settings tab): <Run Text="Verify (read-only)" FontWeight="SemiBold" /> has Claude review an export/import against the live model; <Run Text="Assist (write)" FontWeight="SemiBold" /> lets Claude apply the edits a normal import can’t — chiefly instance parameters on group members.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    The bridge is <Run Text="admin-free" FontWeight="SemiBold" />: it listens only on 127.0.0.1 (loopback) on a high port and requires a per-session token, so other apps and web pages can’t drive it. Use <Run Text="Register with Claude" FontWeight="SemiBold" /> on the ribbon once (registers the bundled connector — no admin), then toggle <Run Text="Claude Bridge" FontWeight="SemiBold" /> on while you work. See “How Claude works” on the Settings tab.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Beyond schedules" FontWeight="SemiBold" /> — with the bridge on, Claude can also read and drive the model directly: render a view to an image, read the current selection, query and filter elements, read/set parameters, run clash checks, tag, create views/sheets/levels, export PDF/DWG/IFC, and more (ask Claude what it can do in Revit). These run through the same loopback bridge and token, so the same on/off toggle governs them.
                </TextBlock>

                <!-- REVISION NARRATIVE -->
                <TextBlock Style="{StaticResource H}" Text="Revision Narrative (Word)" />
                <TextBlock Style="{StaticResource P}">
                    The <Run Text="Revision Narrative" FontWeight="SemiBold" /> button (Revision panel) turns a revision's clouds into a firm-letterhead <Run Text=".docx" FontWeight="SemiBold" /> — reading each cloud's <Run Text="Comments" FontWeight="SemiBold" />, grouping by discipline and sheet, and numbering the items per sheet. It's stand-alone and read-only: it never changes the model and needs no Claude connection.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="1." FontWeight="SemiBold" /> Put your notes in each revision cloud's <Run Text="Comments" FontWeight="SemiBold" /> field (clouds with blank Comments are listed as a warning, not dropped). Click <Run Text="Revision Narrative" FontWeight="SemiBold" />.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="2." FontWeight="SemiBold" /> Pick the revision (defaults to the most recent).
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="3." FontWeight="SemiBold" /> <Run Text="Confirm the project information" FontWeight="SemiBold" /> — a dialog shows the project name, building, address, project number, issue date and the plan set being revised (title + date), all read from the model. Correct anything that's off; your edits flow straight into the document. Nothing is written until you continue.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    <Run Text="4." FontWeight="SemiBold" /> Optionally pick a previous narrative to <Run Text="reuse its header/footer, page setup and fonts" FontWeight="SemiBold" /> (only the body is replaced) — or Cancel that prompt for a plain document. Then choose where to save.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Multiple clouds on one view" FontWeight="SemiBold" /> combine into a single numbered item (e.g. “Detail 8 – note A. note B.”); one note spanning several details reads “Details 1, 3, 4 – …”. A cloud with no discernible detail number gets a click-to-fill <Run Text="[insert]" FontStyle="Italic" /> placeholder. Comment text is tidied to sentence case while sheet callouts and acronyms are preserved.
                </TextBlock>

                <!-- RIBBON REFERENCE -->
                <TextBlock Style="{StaticResource H}" Text="Ribbon buttons" />
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Transom" FontWeight="SemiBold" /> — open the Export / Import dialog.
                    &#x0a;• <Run Text="Check for Updates" FontWeight="SemiBold" /> — install the latest release in place (per-user, no admin).
                    &#x0a;• <Run Text="Help" FontWeight="SemiBold" /> — this window.
                    &#x0a;• <Run Text="Claude Bridge" FontWeight="SemiBold" /> — start/stop the local Claude-assist bridge.
                    &#x0a;• <Run Text="Register with Claude" FontWeight="SemiBold" /> — register the bundled MCP connector with Claude Desktop / Claude Code.
                </TextBlock>

                <!-- TROUBLESHOOTING -->
                <TextBlock Style="{StaticResource H}" Text="Troubleshooting" />
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="“0 changes” or “column not in spreadsheet”" FontWeight="SemiBold" /> — usually a renamed header combined with reordered/inserted columns. Re-export and edit a fresh copy, or undo the column changes.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="“Anchor column not found”" FontWeight="SemiBold" /> — the hidden anchor column or the cowork_meta sheet was removed. Re-export.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="A value didn’t import" FontWeight="SemiBold" /> — check the preview’s skipped panel / Copy log: it may be frozen, unparseable, in a merged cell, or on a duplicated row.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Old export behaves oddly after an update" FontWeight="SemiBold" /> — re-export; capabilities are recorded in the file at export time.
                </TextBlock>
                <TextBlock Style="{StaticResource P}">
                    • <Run Text="Claude can’t reach the bridge" FontWeight="SemiBold" /> — confirm Revit is open with a document, the Claude Bridge toggle is on, you’ve run Register with Claude, and you restarted Claude afterwards.
                </TextBlock>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12">
                        <Run Text="Support:" FontWeight="SemiBold" /> use “Report an issue” below to file a bug or request, or “Releases / docs” for the latest version and documentation. “Check for Updates” on the ribbon updates Transom in place.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
