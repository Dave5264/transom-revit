<Window
    x:Class="Transom.Views.HelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transom — Help &amp; Support"
    Width="560"
    Height="620"
    ResizeMode="CanResizeWithGrip"
    MinWidth="460"
    MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Hint" Color="#9A988E" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
    </Window.Resources>
    <DockPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Foreground="{DynamicResource Hint}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Report an issue" Height="30" Padding="12,0" Margin="0,0,8,0" Click="Issues_Click" />
                <Button Content="Releases / docs" Height="30" Padding="12,0" Margin="0,0,8,0" Click="Releases_Click" />
                <Button Content="Close" Height="30" Padding="14,0" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Transom — Help" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="Transom round-trips Revit schedules through a spreadsheet: export a schedule with full visual fidelity, edit it in Excel, then import your changes back into the model." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Quick start" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    1 · <Run Text="Export" FontWeight="SemiBold" /> tab — tick schedules and save an .xlsx.   2 · Edit values in
                    Excel (keep the hidden columns intact).   3 · <Run Text="Import" FontWeight="SemiBold" /> tab — Browse to the
                    file, <Run Text="Preview changes" FontWeight="SemiBold" />, then <Run Text="Apply selected" FontWeight="SemiBold" />.
                </TextBlock>

                <TextBlock Text="Which schedules round-trip" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Most element schedules — itemized or grouped by type (windows, doors, walls, rooms), and annotation/keyed-note
                    schedules. A schedule exports <Run Text="display-only" FontStyle="Italic" /> when its rows can't map to writable
                    elements (material takeoffs, keynote legends whose text lives in the keynote file, or empty schedules).
                </TextBlock>

                <TextBlock Text="The import preview" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    • <Run Text="Greyed (frozen) rows" FontWeight="SemiBold" /> can't be changed by import — they're driven by the
                    element's family or type selection.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    • <Run Text="Fix-unparseable pane" FontWeight="SemiBold" /> — values that can't be read, or aren't in the
                    schedule's unit format, are held for you to correct/confirm before applying.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    • <Run Text="Group dialog" FontWeight="SemiBold" /> — edits on elements inside Revit groups can be skipped or
                    handed to Claude.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    • <Run Text="Error report" FontWeight="SemiBold" /> (optional checkbox) — a colour-coded .xlsx: blue = skipped,
                    yellow = changed since export, red = unable to write.
                </TextBlock>

                <TextBlock Text="Claude QA (Settings tab)" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Optional. Verify (read-only) has Claude review an import against the model; Assist (write) hands group edits to
                    Claude over a local MCP bridge. See “How Claude works” on the Settings tab.
                </TextBlock>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12">
                        <Run Text="Support:" FontWeight="SemiBold" /> use “Report an issue” below to file a bug or request, or
                        “Releases / docs” for the latest version and documentation. Use “Check for updates” on the ribbon to update in place.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
