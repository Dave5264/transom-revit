<Window
    x:Class="Transom.Views.ClaudeConnectHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Is Claude running?"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
    </Window.Resources>
    <StackPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <TextBlock Text="Claude may be running even when this row shows red" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{DynamicResource Text}" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                   Text="This check looks for known Claude process names, but it can miss Claude Code running inside a terminal, VS Code, or under Node — so a red ✗ here can be a false negative. (Once a session actually loads Transom's tools, the check sees it and turns green.)" />

        <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12"
                       Text="If you have Claude running: export the Claude Assist guide, drop the .md file into your Claude session, and ask for help getting connected. The guide tells Claude how Transom's bridge fits together, so it can test the connection itself and walk you through any remaining setup." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Export Claude Assist guide" Command="{Binding ExportClaudeAssistGuideCommand}"
                    Height="30" Padding="12,0" />
            <Button Content="Close" Click="Close_Click" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
