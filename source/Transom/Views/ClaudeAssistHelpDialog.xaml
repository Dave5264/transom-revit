<Window
    x:Class="Transom.Views.ClaudeAssistHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="How Claude Assist works"
    Width="540"
    Height="560"
    ResizeMode="CanResizeWithGrip"
    MinWidth="440"
    MinHeight="380"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
        <SolidColorBrush x:Key="CodeBg" Color="#EEF1F4" />
    </Window.Resources>
    <DockPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <Button DockPanel.Dock="Bottom" Content="Got it" Width="92" Height="32" HorizontalAlignment="Right"
                Margin="0,14,0,0" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                Click="Close_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="Claude Assist" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="Transom writes most schedule edits directly. A few can't be applied in place — most often parameters on elements inside Revit groups (group members can't be changed outside group-edit mode). Transom hands those to Claude over a local MCP write bridge." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="1 · Set up the write bridge (one time)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource Text}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Set <Run Text="Claude mode" FontWeight="SemiBold" /> to “Assist (write)” in Settings, and start the
                    write MCP server (the community Revit MCP via pyRevit Routes, port 48884). The bridge status
                    should read “available”.
                </TextBlock>

                <TextBlock Text="2 · Import as usual" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource Text}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Preview, then <Run Text="Apply selected" FontWeight="SemiBold" />. If any edits target elements in
                    groups, Transom shows the group dialog.
                </TextBlock>

                <TextBlock Text="3 · Choose “Let Claude open the groups”" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource Text}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Transom asks you where to save an artifact file (<Run Text="transom_group_edits.json" FontStyle="Italic" />)
                    listing each element, parameter, and value. Everything not in a group is applied right away.
                </TextBlock>

                <TextBlock Text="4 · Ask Claude to apply it" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource Text}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,6">
                    In your Claude session connected to the Revit write MCP (Claude Code, or Claude Desktop with the
                    revit MCP), tell Claude:
                </TextBlock>
                <Border Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                               Text="Apply the staged Transom group edits at &lt;path to the .json file&gt;." />
                </Border>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Claude reads the file and applies each edit over the bridge — ungrouping the affected instances,
                    writing the parameter, and restoring grouping as needed.
                </TextBlock>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12">
                            <Run Text="Note:" FontWeight="SemiBold" /> Transom doesn’t message Claude itself — it
                            produces the artifact; you ask Claude to act on it.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,6,0,0">
                            “Verify (read-only)” mode lets Claude review an import against the model without the write bridge.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
