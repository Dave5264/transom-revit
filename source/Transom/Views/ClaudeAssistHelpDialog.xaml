<Window
    x:Class="Transom.Views.ClaudeAssistHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="How Claude works in Transom"
    Width="540"
    Height="620"
    ResizeMode="CanResizeWithGrip"
    MinWidth="440"
    MinHeight="380"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
        <SolidColorBrush x:Key="CodeBg" Color="#EEF1F4" />
    </Window.Resources>
    <DockPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <Button DockPanel.Dock="Bottom" Content="Got it" Width="92" Height="32" HorizontalAlignment="Right"
                Margin="0,14,0,0" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                Click="Close_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="Claude QA — Verify &amp; Assist" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="Transom can bring Claude in to QA your round-trip over a local MCP connection — two modes, set by &quot;Claude mode&quot; in Settings. Transom never messages Claude itself; it stages files and you ask Claude to act on them." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== VERIFY ===== -->
                <TextBlock Text="Verify (read-only)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8">
                    Claude reviews an export or a pending import against the live model and flags issues — drift,
                    mismatched values, risky edits — <Run Text="before" FontStyle="Italic" /> you commit. It only reads
                    the model through Transom's bundled bridge, so nothing is written.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    1 · Set <Run Text="Claude mode" FontWeight="SemiBold" /> to “Verify (read-only)”, and set a Claude exchange folder.
                    (One-time: <Run Text="Set up Claude" FontWeight="SemiBold" /> on the ribbon + restart Claude Code, then turn <Run Text="Claude Bridge" FontWeight="SemiBold" /> ON.)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    2 · Export or Preview as usual — Transom stages the workbook + a run-log to the exchange folder.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    3 · In Claude Code, ask:
                </TextBlock>
                <Border Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                               Text="Review the staged Transom workbook against the model and flag anything off." />
                </Border>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,16">
                    4 · Claude reports discrepancies. Nothing is written — you decide what to apply.
                </TextBlock>

                <!-- ===== ASSIST ===== -->
                <TextBlock Text="Assist (write)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8">
                    Transom writes most edits directly. A few can't be applied in place — most often parameters on
                    elements inside Revit groups (group members can't be changed outside group-edit mode). In Assist,
                    Claude applies those for you over a local MCP write bridge.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    1 · One-time: click <Run Text="Set up Claude" FontWeight="SemiBold" /> on the ribbon (registers
                    Transom's bundled MCP servers with Claude Code — no admin), then <Run Text="restart Claude Code" FontWeight="SemiBold" /> so it loads them.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    2 · Turn <Run Text="Claude Bridge" FontWeight="SemiBold" /> ON (ribbon toggle). It listens on
                    127.0.0.1:48810 (the default; change it in Settings) — the bridge status should read “available”.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    3 · Import → <Run Text="Preview" FontWeight="SemiBold" /> → <Run Text="Apply selected" FontWeight="SemiBold" />.
                    If edits target group members, the group dialog appears — pick <Run Text="Claude-Assist" FontWeight="SemiBold" />
                    and choose where to save the artifact (<Run Text="transom_group_edits.json" FontStyle="Italic" />).
                    Everything not in a group applies right away.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    4 · In Claude Code, drag the staged <Run Text="transom_group_edits.json" FontStyle="Italic" /> into the chat and say:
                </TextBlock>
                <Border Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                               Text="Apply these staged Transom group edits." />
                </Border>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Claude reads the file and, for each grouped built-in, drives Revit's “Edit Group” mode (via the
                    UI-Assist server) to set the value and verify it — the group's members stay intact. Ungrouped
                    edits and project/shared params it writes directly over the bridge.
                </TextBlock>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12">
                        <Run Text="The two read paths differ:" FontWeight="SemiBold" /> Verify reads the model to review
                        (no writes); Assist turns on the bridge so Claude can actually change the model.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
