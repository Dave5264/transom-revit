<Window
    x:Class="Transom.Views.ClaudeAssistHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="How Claude works in Transom"
    Width="540"
    Height="620"
    ResizeMode="CanResizeWithGrip"
    MinWidth="440"
    MinHeight="380"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
        <SolidColorBrush x:Key="CodeBg" Color="#EEF1F4" />
    </Window.Resources>
    <DockPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">

        <Button DockPanel.Dock="Bottom" Content="Got it" Width="92" Height="32" HorizontalAlignment="Right"
                Margin="0,14,0,0" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                Click="Close_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="Claude Assist — how it works" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="One switch in Settings brings Claude in over a local MCP connection. The first time you turn it on, Transom registers its tools with your Claude client (restart Claude once afterward). Transom never messages Claude itself; it stages files and you ask Claude to act on them." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== REVIEW ===== -->
                <TextBlock Text="Review a round-trip (read-only asks)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8">
                    Claude reviews an export or a pending import against the live model and flags issues — drift,
                    mismatched values, risky edits — <Run Text="before" FontStyle="Italic" /> you commit. A review
                    reads the model through Transom's bundled bridge and changes nothing; you decide what to apply.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    1 · Turn <Run Text="Claude Assist" FontWeight="SemiBold" /> on (Settings tab). The status panel
                    below the switch shows every layer is in place.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    2 · Export or Preview as usual — Transom stages the workbook + a run-log to the exchange folder.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    3 · In Claude Code, ask:
                </TextBlock>
                <Border Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                               Text="Review the staged Transom workbook against the model and flag anything off." />
                </Border>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,16">
                    4 · Claude reports discrepancies. Nothing is written — you decide what to apply.
                </TextBlock>

                <!-- ===== APPLY ===== -->
                <TextBlock Text="Apply staged group edits" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8">
                    Transom writes most edits directly. A few can't be applied in place — most often parameters on
                    elements inside Revit groups (group members can't be changed outside group-edit mode). With
                    Claude Assist on, Claude applies those for you over the local bridge (it listens on
                    127.0.0.1:48810 by default; change the port under Advanced in Settings).
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    1 · Import → <Run Text="Preview" FontWeight="SemiBold" /> → <Run Text="Apply selected" FontWeight="SemiBold" />.
                    If edits target group members, the group dialog appears — pick <Run Text="Claude-Assist" FontWeight="SemiBold" />
                    and choose where to save the artifact (<Run Text="transom_group_edits.json" FontStyle="Italic" />).
                    Everything not in a group applies right away.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,4">
                    2 · In Claude Code, drag the staged <Run Text="transom_group_edits.json" FontStyle="Italic" /> into the chat and say:
                </TextBlock>
                <Border Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                               Text="Apply these staged Transom group edits." />
                </Border>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12">
                    Claude reads the file and, for each grouped built-in, drives Revit's “Edit Group” mode (via the
                    UI-Assist server) to set the value and verify it — the group's members stay intact. Ungrouped
                    edits and project/shared params it writes directly over the bridge.
                </TextBlock>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12">
                        <Run Text="One switch, everything" FontWeight="SemiBold" /> — the Settings toggle starts the
                        bridge with Revit and keeps it running until you turn it off; the status panel next to it
                        shows every layer (bridge, shim, Claude registration) at a glance. While Claude Assist is on,
                        Claude can write to the model — when you only want a check, keep your prompts to
                        review-only asks.
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
