<Window
    x:Class="Transom.Views.GroupConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Elements in groups"
    SizeToContent="Height"
    Width="460"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F4F3EE" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#26251F" />
        <SolidColorBrush x:Key="Muted" Color="#6B6A62" />
        <SolidColorBrush x:Key="Line" Color="#E3E1D9" />
        <SolidColorBrush x:Key="Accent" Color="#185FA5" />
        <SolidColorBrush x:Key="InfoBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="AccentLine" Color="#85B7EB" />
    </Window.Resources>
    <StackPanel Margin="18" TextElement.Foreground="{DynamicResource Text}">
        <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" />

        <!-- Claude hint, shown only when Assist is off -->
        <Border x:Name="ClaudeHint" Visibility="Collapsed"
                Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,4">
            <TextBlock Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap"
                       Text="💡 Claude can open the groups and apply these for you — switch Claude mode to “Assist (write)” in Settings, then preview again." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel import" Height="32" Padding="12,0" Margin="0,0,8,0" Click="Abort_Click" />
            <Button Content="Skip grouped &amp; apply rest" Height="32" Padding="14,0" Margin="0,0,8,0" Click="Skip_Click" />
            <Button x:Name="ClaudeButton" Content="Let Claude open the groups" Height="32" Padding="16,0"
                    Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                    Visibility="Collapsed" Click="Claude_Click" />
        </StackPanel>
    </StackPanel>
</Window>
