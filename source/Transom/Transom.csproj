<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <DeployAddin>true</DeployAddin>
        <LaunchRevit>false</LaunchRevit>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!-- Transom targets Revit 2025 & 2026 (.NET 8) and 2027 (.NET 10) -->
        <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>

        <!-- Excel engine: xlsx (XSSF) + legacy xls (HSSF). Pinned per plan; co-deployed via dynamic loading. -->
        <PackageReference Include="NPOI" Version="2.7.1"/>
        <!-- Override NPOI's transitive SixLabors.ImageSharp 2.1.8 (known CVEs) with the patched 2.1.x.
             2.1.10 clears both high-severity CVEs + one moderate. The last moderate (GHSA-rxmq-m78w-7wmc)
             is fixed only in ImageSharp 3.x, which NPOI 2.7.1 is not compatible with; it is an image-decode
             path Transom never invokes (no image cells), so it is suppressed individually below.
             Revisit when NPOI targets ImageSharp 3.x. -->
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.10"/>

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>

        <!-- Roslyn C# scripting (execute_revit_code) lives in Transom.Scripting.dll, loaded into a DEDICATED
             AssemblyLoadContext at run time (Core/ScriptIsolation.cs) so Microsoft.CodeAnalysis* never binds in
             Revit's shared default context — where another add-in (pyRevit ships Roslyn 4.10) can already hold
             an older copy and win the bind (FileLoadException 0x80131621). This ProjectReference gives build
             ordering and flows the Roslyn DLL closure into the output folder; Transom source must never use a
             Microsoft.CodeAnalysis OR Transom.Scripting type directly — reflection into ScriptHost only. -->
        <ProjectReference Include="..\Transom.Scripting\Transom.Scripting.csproj"/>

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all"/>
    </ItemGroup>
    
    <ItemGroup>
        <!-- See SixLabors.ImageSharp note above: unused image-decode path, fixed only in incompatible 3.x. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxmq-m78w-7wmc"/>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\RibbonIcon16.png"/>
        <Resource Include="Resources\Icons\RibbonIcon32.png"/>
        <Resource Include="Resources\Icons\Update16.png"/>
        <Resource Include="Resources\Icons\Update32.png"/>
        <Resource Include="Resources\Icons\Help16.png"/>
        <Resource Include="Resources\Icons\Help32.png"/>
        <Resource Include="Resources\Icons\Bridge16.png"/>
        <Resource Include="Resources\Icons\Bridge32.png"/>
        <Resource Include="Resources\Icons\Register16.png"/>
        <Resource Include="Resources\Icons\Register32.png"/>
        <Resource Include="Resources\Icons\UiAssist16.png"/>
        <Resource Include="Resources\Icons\UiAssist32.png"/>
        <Resource Include="Resources\Icons\Settings16.png"/>
        <Resource Include="Resources\Icons\Settings32.png"/>
        <Resource Include="Resources\Icons\RevisionNarrative16.png"/>
        <Resource Include="Resources\Icons\RevisionNarrative32.png"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models"/>
    </ItemGroup>

    <!-- Optional Claude UI-Assist payload. Bundle the two self-contained Click Helper exes next to Transom.dll
         so the local dev deploy (DeployAddin) ships them — mirroring what PublishClickHelperModule does for the
         installer's publish folders. <Link> forces them to the output root (not a mirrored sub-path); <Visible>
         hides them in Solution Explorer. Guarded by Exists(): a fresh clone that hasn't published the Click
         Helper projects simply skips them and the build still succeeds — run the build pipeline (or publish
         those two projects) to populate the payload. They are version-agnostic (one net8.0-windows self-contained
         exe drives Revit 2025/2026/2027), so the same files are bundled for every configuration. -->
    <ItemGroup>
        <None Include="..\Transom.ClickHelper\bin\Release\net8.0-windows\win-x64\publish\Transom.ClickHelper.exe"
              Condition="Exists('..\Transom.ClickHelper\bin\Release\net8.0-windows\win-x64\publish\Transom.ClickHelper.exe')">
            <Link>Transom.ClickHelper.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
        <None Include="..\Transom.ClickHelper.Mcp\bin\Release\net8.0\win-x64\publish\Transom.ClickHelper.Mcp.exe"
              Condition="Exists('..\Transom.ClickHelper.Mcp\bin\Release\net8.0\win-x64\publish\Transom.ClickHelper.Mcp.exe')">
            <Link>Transom.ClickHelper.Mcp.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

</Project>