<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <DeployAddin>true</DeployAddin>
        <LaunchRevit>false</LaunchRevit>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!-- Roslyn ships its compiler diagnostics translated into 13 languages; those satellite assemblies
             are ~7 MB per Revit year and Transom's own UI is English-only, so nothing reads them. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- Transom targets Revit 2025 & 2026 (.NET 8) and 2027 (.NET 10) -->
        <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>

        <!-- The Excel/docx engine (NPOI + closure) lives in Transom.Office.dll, loaded into a DEDICATED
             AssemblyLoadContext at run time (Core/OfficeIsolation.cs) so the NPOI family never binds in
             Revit's shared default context — same isolation as Transom.Scripting/Roslyn below. NO NPOI or
             SixLabors PackageReference belongs here, and Transom source must never use an NPOI or
             Transom.Office type directly — only Core/IOfficeEngine.cs via OfficeIsolation.Engine.
             NOTE: there is deliberately NO ProjectReference to Transom.Office (it references US for the
             DTOs; a reference here would be circular AND would drag the NPOI closure into the default
             context). Build source/Transom.Office/Transom.Office.csproj per config — it builds this
             project first, then copies the engine + closure into our output/publish/Addins folders. -->

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>

        <!-- Roslyn C# scripting (execute_revit_code) lives in Transom.Scripting.dll, loaded into a DEDICATED
             AssemblyLoadContext at run time (Core/ScriptIsolation.cs) so Microsoft.CodeAnalysis* never binds in
             Revit's shared default context — where another add-in (pyRevit ships Roslyn 4.10) can already hold
             an older copy and win the bind (FileLoadException 0x80131621). This ProjectReference gives build
             ordering and flows the Roslyn DLL closure into the output folder; Transom source must never use a
             Microsoft.CodeAnalysis OR Transom.Scripting type directly — reflection into ScriptHost only. -->
        <ProjectReference Include="..\Transom.Scripting\Transom.Scripting.csproj"/>

        <!-- AIRE (engine + job runner + window). Extracted out of Transom so the SAME code can also run in
             the standalone AIRE app with Revit closed; unlike Scripting/Office this is an ORDINARY reference
             loaded into the default context — it has no conflicting dependency closure to isolate (BCL only),
             and AireCommand/BridgeToolsAire use its types directly. -->
        <ProjectReference Include="..\Transom.Aire\Transom.Aire.csproj"/>

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all"/>
    </ItemGroup>
    
    <PropertyGroup>
        <!-- Scripting builds plain net8.0 (R25/R26) / net10.0 (R27) — it must not carry the -windows7.0
             suffix our own TFM has, so derive its output folder from the configuration, not TargetFramework. -->
        <ScriptingTfm>net8.0</ScriptingTfm>
        <ScriptingTfm Condition="$(Configuration.EndsWith('R27'))">net10.0</ScriptingTfm>
        <ScriptingDepsJson>..\Transom.Scripting\bin\$(Configuration)\$(ScriptingTfm)\Transom.Scripting.deps.json</ScriptingDepsJson>
    </PropertyGroup>
    <ItemGroup>
        <!-- Ship the Scripting satellite's deps.json so ScriptIsolation's AssemblyDependencyResolver arm
             works (it was silently absent before 2026-07-12; prefix matching carried everything). Guarded by
             Exists() like the ClickHelper payload: present from the second build of a fresh clone onward.
             Transom.Office's equivalent arrives via its own CopyIntoTransom post-build target. -->
        <None Include="$(ScriptingDepsJson)"
              Condition="Exists('$(ScriptingDepsJson)')">
            <Link>Transom.Scripting.deps.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\RibbonIcon16.png"/>
        <Resource Include="Resources\Icons\RibbonIcon32.png"/>
        <Resource Include="Resources\Icons\Update16.png"/>
        <Resource Include="Resources\Icons\Update32.png"/>
        <Resource Include="Resources\Icons\Help16.png"/>
        <Resource Include="Resources\Icons\Help32.png"/>
        <Resource Include="Resources\Icons\Bridge16.png"/>
        <Resource Include="Resources\Icons\Bridge32.png"/>
        <Resource Include="Resources\Icons\Register16.png"/>
        <Resource Include="Resources\Icons\Register32.png"/>
        <Resource Include="Resources\Icons\UiAssist16.png"/>
        <Resource Include="Resources\Icons\UiAssist32.png"/>
        <Resource Include="Resources\Icons\Settings16.png"/>
        <Resource Include="Resources\Icons\Settings32.png"/>
        <Resource Include="Resources\Icons\RevisionNarrative16.png"/>
        <Resource Include="Resources\Icons\RevisionNarrative32.png"/>
        <Resource Include="Resources\Icons\Aire16.png"/>
        <Resource Include="Resources\Icons\Aire32.png"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models"/>
    </ItemGroup>

    <!-- Optional Claude UI-Assist payload. Bundle the two self-contained Click Helper exes next to Transom.dll
         so the local dev deploy (DeployAddin) ships them — mirroring what PublishClickHelperModule does for the
         installer's publish folders. <Link> forces them to the output root (not a mirrored sub-path); <Visible>
         hides them in Solution Explorer. Guarded by Exists(): a fresh clone that hasn't published the Click
         Helper projects simply skips them and the build still succeeds — run the build pipeline (or publish
         those two projects) to populate the payload. They are version-agnostic (one net8.0-windows self-contained
         exe drives Revit 2025/2026/2027), so the same files are bundled for every configuration. -->
    <!-- Skills shipped with Transom (Claude Skills tab, user request 2026-07-18): copied into a "skills"
         subfolder of the payload; SkillLibrary.EnsureSeeded copies them to %LocalAppData%\Transom\skills on
         first launch (never overwriting a user-edited copy). Add new shipped skills to Resources\Skills. -->
    <ItemGroup>
        <None Include="Resources\Skills\*.md">
            <Link>skills\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Transom.ClickHelper\bin\Release\net8.0-windows\win-x64\publish\Transom.ClickHelper.exe"
              Condition="Exists('..\Transom.ClickHelper\bin\Release\net8.0-windows\win-x64\publish\Transom.ClickHelper.exe')">
            <Link>Transom.ClickHelper.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
        <None Include="..\Transom.ClickHelper.Mcp\bin\Release\net8.0\win-x64\publish\Transom.ClickHelper.Mcp.exe"
              Condition="Exists('..\Transom.ClickHelper.Mcp\bin\Release\net8.0\win-x64\publish\Transom.ClickHelper.Mcp.exe')">
            <Link>Transom.ClickHelper.Mcp.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <!-- BUILD-ORDER FIX (regression guard for the v1.8.0 engine drop): Transom.Office (the Excel/docx engine +
         NPOI closure) is DELIBERATELY not referenced from here — a ProjectReference would be circular (Office
         references US for the DTOs) and would drag the NPOI closure into Revit's shared default load context,
         defeating the isolation. Because nothing referenced it, nothing built it, and it silently fell out of the
         packaged MSI in v1.8.0–v1.9.1 (Export then died with a mislabeled "open in Excel" error). Build it here
         AFTER Transom is built: BuildProjectReferences=false stops it from rebuilding (or cycling back into) us
         and just binds our fresh output. Office's own CopyIntoTransom target (AfterTargets=Build) then stages
         Transom.Office.dll + the closure into our output, publish/Transom/, and the dev Addins folder — so this
         also fixes the dev-deploy gap, not just the MSI. The installer ALSO hard-fails if the engine isn't in the
         harvest (install/Installer.cs, AssertEngineHarvested), so a missed engine can never silently ship again. -->
    <Target Name="BuildOfficeEngine" AfterTargets="Build">
        <!-- Restore first, in its OWN invocation: Office's TFM flips per Configuration (net8.0-windows for
             R25/R26, net10.0-windows for R27), so its obj\project.assets.json from any other config fails the
             build with NETSDK1005, and nothing else restores this unreferenced project. The property sets differ
             between the two invocations, so MSBuild evaluates the Build leg fresh and sees the new assets file. -->
        <MSBuild Projects="..\Transom.Office\Transom.Office.csproj"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration)"
                 BuildInParallel="false" />
        <MSBuild Projects="..\Transom.Office\Transom.Office.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);BuildProjectReferences=false"
                 BuildInParallel="false" />
    </Target>

</Project>