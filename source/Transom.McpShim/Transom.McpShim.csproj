<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Transom.McpShim</AssemblyName>
    <RootNamespace>Transom.McpShim</RootNamespace>

    <!-- Self-contained, single-file publish: load-bearing.
         The shim must run with NO admin rights and NO separate .NET runtime
         install (it bundles its own runtime). See BUNDLED_MCP_PLAN.md (retired 2026-07-13; archived locally) constraint 3. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Halves the bundled runtime on disk (64 MB -> ~34 MB). The shim is a long-lived stdio server started
         once per Claude session, so the one-time extract to the per-user cache is not on any hot path. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Dependencies: only System.Text.Json + System.Net.Http, both part of the
       shared framework for net8.0. No external NuGet packages. -->

  <ItemGroup>
    <!-- AIRE's engine, job runner and aire_* tool surface, hosted IN THIS PROCESS so Claude can enhance
         renders and generate clips with Revit closed and the AIRE window closed. Transom.Aire.Core exists
         precisely to make this reference legal: it is BCL-only and, crucially, NOT UseWPF, so it does not
         drag the desktop runtime into this self-contained single-file bundle. Keep it that way — referencing
         Transom.Aire (the window) here would roughly triple the shim.

         No NuGet packages come with it, so the "no external packages" rule above still holds. -->
    <ProjectReference Include="..\Transom.Aire.Core\Transom.Aire.Core.csproj"/>
  </ItemGroup>

</Project>
