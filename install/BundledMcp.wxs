<?xml version="1.0" encoding="UTF-8"?>
<!--
  BundledMcp.wxs  —  F4: per-user component group for the bundled MCP shim.

  Schema: WiX v3 ( http://schemas.microsoft.com/wix/2006/wi ).
  This matches the WiX dialect emitted by WixSharp.Core 2.14.0, which the rest of
  the installer is authored in (install/Installer.cs builds a WixSharp `Project`
  with `Scope = InstallScope.perUser`). WixSharp lets you splice a raw .wxs
  fragment into the generated source via `project.WixSourceGenerated` / the
  `-ext`/include mechanism, OR you can hand this fragment to candle/light directly
  if the build ever moves to native WiX. Either way the authoring below is plain
  WiX3 so it is portable.

  ADMIN-FREE CONTRACT (BUNDLED_MCP_PLAN.md (retired 2026-07-13; archived locally), constraint #1 — per-user install only):
    * Everything lands under LocalAppDataFolder (%LocalAppData%\Transom\mcp\).
    * NO ProgramFilesFolder / ProgramFiles64Folder.
    * NO HKLM — the per-component keypath is written to HKCU only.
    * NO ServiceInstall / ServiceControl, NO custom action that needs elevation.
    * The whole MSI is installed perUser (see Installer.cs BuildSingleUserMsi),
      so MSIINSTALLPERUSER=1 and ALLUSERS="" — Windows shows NO UAC prompt.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <!--
      Per-user directory tree:  %LocalAppData%\Transom\mcp\
      LocalAppDataFolder is the standard MSI per-user property; under a perUser
      install it resolves to C:\Users\<me>\AppData\Local with no elevation.
      (The existing add-in payload goes to %AppDataFolder%\Autodesk\Revit\Addins\
      via WixSharp in Installer.cs; the shim is intentionally separate so it is
      not version-fanned per Revit release.)
    -->
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="TransomLocalDir" Name="Transom">
          <Directory Id="TransomMcpDir" Name="mcp" />
        </Directory>
      </Directory>
    </DirectoryRef>

    <!--
      The published, self-contained, single-file shim (BUNDLED_MCP_PLAN.md (retired 2026-07-13; archived locally) F3 /
      constraint #3). It bundles its own .NET runtime, so there is never an
      "install .NET" step. Built by:
        dotnet publish source/Transom.McpShim/Transom.McpShim.csproj `
          -c Release -r win-x64 --self-contained `
          -p:PublishSingleFile=true
      and the resulting single Transom.McpShim.exe is the only payload here.

      Per-user component pattern: a perUser component CANNOT use the installed
      file as its keypath reliably, so the keypath is an HKCU registry value
      (NOT HKLM). This is the canonical "RegistryValue keypath for a per-user
      component" idiom and keeps us 100% out of HKLM.
    -->
    <ComponentGroup Id="BundledMcpComponents" Directory="TransomMcpDir">
      <Component Id="cmpTransomMcpShim"
                 Guid="9F2A7C61-3B84-4D2E-9E0A-6C1D5F8B42A7">

        <!-- HKCU keypath — per-user, no admin, survives repair correctly. -->
        <RegistryValue Root="HKCU"
                       Key="Software\Transom\Mcp"
                       Name="ShimInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

        <!-- The self-contained shim exe itself. -->
        <File Id="filTransomMcpShimExe"
              Name="Transom.McpShim.exe"
              Source="$(var.McpShimPublishDir)\Transom.McpShim.exe" />

        <!--
          Record the resolved install path of the shim in HKCU so the add-in's
          first-run config-merge step (see MCP_CONFIG_MERGE.md, option A) can
          discover the exe path deterministically instead of guessing. Written
          per-user; no admin.
        -->
        <RegistryValue Root="HKCU"
                       Key="Software\Transom\Mcp"
                       Name="ShimPath"
                       Type="string"
                       Value="[TransomMcpDir]Transom.McpShim.exe" />

        <!-- Default loopback port (constraint #2). The add-in / shim read this
             as a hint; user can override via TransomSettings.BridgeSelfHostPort. -->
        <RegistryValue Root="HKCU"
                       Key="Software\Transom\Mcp"
                       Name="BridgePort"
                       Type="integer"
                       Value="48810" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>

<!--
  ============================================================================
  INTEGRATION — where the MAIN installer must reference this fragment
  ============================================================================
  The main installer is WixSharp (install/Installer.cs). Two equivalent ways to
  pull this fragment + its ComponentGroup into the SingleUser MSI:

  (1) Native-WiX style (if/when the build feeds raw .wxs to candle/light), add
      this inside the perUser <Product>/<Feature> that the SingleUser MSI emits:

          <Feature Id="...existing per-user feature..." ... >
            <!-- ADD THIS LINE: -->
            <ComponentGroupRef Id="BundledMcpComponents" />
          </Feature>

      and define the publish-dir variable on the light/candle command line:

          -dMcpShimPublishDir=<abs path to the published shim folder>

  (2) WixSharp style (current build, install/Installer.cs BuildSingleUserMsi):
      keep this .wxs as a literal fragment and merge it via WixSharp, e.g.

          project.WixSourceGenerated += doc => doc.MergeWith(
              XDocument.Load(@"install\BundledMcp.wxs"));

      then ensure the per-user feature carries the group. Because WixSharp wraps
      everything in one Feature for the SingleUser build, the simplest path is to
      add a WixSharp `Dir`/`File` mirror of this component into the perUser
      `project.Dirs` in BuildSingleUserMsi(); this .wxs then serves as the
      canonical, reviewable spec of EXACTLY what that component must contain
      (LocalAppDataFolder\Transom\mcp\Transom.McpShim.exe + HKCU keypath, no HKLM).

  Set $(var.McpShimPublishDir) to the folder produced by `dotnet publish` of
  Transom.McpShim (see comment above the <File> element).
  ============================================================================
-->
